# Wonder Lab environment template. NO SECRETS ARE COMMITTED.
# This vertical slice is local-first: it needs none of these to run.
# Anything prefixed VITE_ is shipped to the browser — never put a secret there.

VITE_PUBLIC_SUPABASE_URL=
VITE_PUBLIC_SUPABASE_ANON_KEY=

# --- server only (future API layer; not used by this slice) ---
SUPABASE_SERVICE_ROLE_KEY=
SESSION_SIGNING_SECRET=

# Live AI is default-deny. Both flags must be the literal string "true" on the
# SERVER, Gate C must be signed off in docs/privacy-readiness.md, and a valid
# provider-processing consent record must exist, or live requests are refused.
LIVE_AI_ENABLED=false
PROVIDER_PRIVACY_APPROVED=false
LIVE_AI_PROVIDER=none
AI_PROVIDER_API_KEY=

BACKUP_BUCKET=
BACKUP_ACCESS_KEY=
BACKUP_SECRET_KEY=
